QWidget {
    background: #f5f8ff;
    color: #1f2a37;
    font-family: "Segoe UI";
    font-size: 10pt;
}

QMainWindow {
    background: #edf3ff;
}

QLabel {
    background: transparent;
}

QFrame#Header {
    background: qlineargradient(x1: 0, y1: 0, x2: 1, y2: 1,
      stop: 0 #0f4ec8, stop: 1 #2f7ae5);
    border-radius: 14px;
}

QLabel#HeaderTitle {
    color: white;
    font-size: 14pt;
    font-weight: 700;
}

QLabel#HeaderMeta, QLabel#active_jobs_label {
    color: #dbe8ff;
    font-size: 9pt;
}

QTabWidget::pane {
    border: 1px solid #d6e1f5;
    border-radius: 10px;
    background: white;
    top: -1px;
}

QTabBar::tab {
    background: #dce8fb;
    border: 1px solid #b8cdf0;
    padding: 8px 14px;
    margin-right: 4px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QTabBar::tab:selected {
    background: white;
    border-bottom: 1px solid white;
}

QPushButton {
    background: #1a66dc;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 8px 12px;
    font-weight: 600;
}

QPushButton:hover {
    background: #0f58c9;
    border: 1px solid #7fa8ee;
}

QPushButton:pressed {
    background: #0a3f99;
    padding-top: 10px;
    padding-bottom: 6px;
}

QPushButton:focus {
    border: 2px solid #8fb4f5;
}

QPushButton:disabled {
    background: #9eb8e8;
    border: none;
}

QPushButton#pause_queue_btn,
QPushButton#research_cancel_btn,
QPushButton#research_select_all_btn,
QPushButton#browse_folder_btn,
QPushButton#pick_cookies_btn,
QPushButton#refresh_history_btn,
QPushButton#retry_failed_btn {
    background: #e7eefb;
    color: #214b8f;
    border: 1px solid #bfd2f3;
}

QPushButton#pause_queue_btn:hover,
QPushButton#research_cancel_btn:hover,
QPushButton#research_select_all_btn:hover,
QPushButton#browse_folder_btn:hover,
QPushButton#pick_cookies_btn:hover,
QPushButton#refresh_history_btn:hover,
QPushButton#retry_failed_btn:hover {
    background: #d3e2fb;
    border: 1px solid #7fa8ee;
}

QPushButton#pause_queue_btn:pressed,
QPushButton#research_cancel_btn:pressed,
QPushButton#research_select_all_btn:pressed,
QPushButton#browse_folder_btn:pressed,
QPushButton#pick_cookies_btn:pressed,
QPushButton#refresh_history_btn:pressed,
QPushButton#retry_failed_btn:pressed {
    background: #b7cff5;
}

QPushButton#pause_queue_btn:disabled,
QPushButton#research_cancel_btn:disabled {
    background: #f0f3f9;
    color: #9aa8c2;
    border: 1px solid #dde5f3;
}

QPushButton#clear_btn,
QPushButton#clear_all_btn,
QPushButton#clear_history_btn {
    background: #f5b742;
    color: #263238;
}

QPushButton#clear_btn:hover,
QPushButton#clear_all_btn:hover,
QPushButton#clear_history_btn:hover {
    background: #f0a21b;
    border: 1px solid #c98200;
}

QPushButton#clear_btn:pressed,
QPushButton#clear_all_btn:pressed,
QPushButton#clear_history_btn:pressed {
    background: #d98f0a;
}

QLineEdit:hover, QComboBox:hover, QSpinBox:hover {
    border: 1px solid #7fa8ee;
}

QLineEdit:focus, QComboBox:focus, QSpinBox:focus {
    border: 2px solid #1a66dc;
}

QTabBar::tab:hover:!selected {
    background: #cddff9;
}

QTableWidget::item:hover {
    background: #eaf2ff;
}

QTableWidget::item:selected {
    background: #cfe0fb;
    color: #14284b;
}

QLineEdit, QComboBox, QSpinBox {
    border: 1px solid #c7d5ee;
    border-radius: 8px;
    padding: 6px;
    background: white;
}

QTableWidget {
    border: 1px solid #d6e1f5;
    border-radius: 8px;
    background: #ffffff;
    gridline-color: #e8eefb;
    alternate-background-color: #f7faff;
}

QHeaderView::section {
    background: #e7efff;
    border: none;
    border-bottom: 1px solid #c8d8f6;
    padding: 8px;
    font-weight: 600;
}

QStatusBar {
    background: white;
    border-top: 1px solid #d6e1f5;
}
